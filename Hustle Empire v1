<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>Hustle Empire</title>
<style>
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
body{margin:0;background:#0f1218;color:#f5f7fb;font-family:Arial,sans-serif}
.app{max-width:520px;margin:auto;min-height:100vh;background:#181d27}
header{padding:18px 15px 13px;background:#202735;position:sticky;top:0;z-index:5}
.title{font-size:25px;font-weight:900}.sub{font-size:13px;color:#9da7b8;margin-top:3px}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:14px}
.stat{background:#12161e;border-radius:12px;padding:9px}.label{font-size:10px;color:#929cac}.value{font-weight:800;margin-top:3px}
main{padding:15px 15px 85px}.page{display:none}.page.active{display:block}
.card,.biz{background:#212836;border:1px solid #30394a;border-radius:16px;padding:14px;margin-bottom:12px}
h2{font-size:18px;margin:0 0 8px}.muted{color:#9da7b8;font-size:13px}
.money{font-size:30px;font-weight:900;margin:5px 0 13px}
.progress{height:8px;background:#12161e;border-radius:99px;overflow:hidden;margin:8px 0}
.bar{height:100%;background:#527cff;width:0}
.row{display:flex;justify-content:space-between;align-items:center;gap:10px}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.biz{margin:0;padding:12px}.emoji{font-size:28px}.biz h3{margin:5px 0;font-size:15px}
.biz p{font-size:12px;color:#9da7b8;min-height:30px}
button{cursor:pointer}.action{width:100%;border:0;border-radius:10px;background:#527cff;color:white;padding:12px;font-weight:800;margin-top:9px}
.action:disabled{opacity:.4}.badge{font-size:10px;background:#30394a;border-radius:20px;padding:5px 7px}
.log{font-size:12px;color:#bbc3d0;padding:8px 0;border-bottom:1px solid #30394a}
nav{position:fixed;bottom:0;left:50%;transform:translateX(-50%);width:100%;max-width:520px;display:grid;grid-template-columns:repeat(4,1fr);background:#11151d;border-top:1px solid #30394a;z-index:10}
nav button{border:0;background:none;color:#8f99aa;padding:10px 2px;font-size:11px}
nav button.active{color:white}
</style>
</head>
<body>
<div class="app">
<header>
<div class="title">💼 Hustle Empire</div>
<div class="sub">Build from broke to business mogul</div>
<div class="stats">
<div class="stat"><div class="label">CASH</div><div class="value" id="cash">$100</div></div>
<div class="stat"><div class="label">REP</div><div class="value" id="rep">0</div></div>
<div class="stat"><div class="label">DAY</div><div class="value" id="day">1</div></div>
</div>
</header>

<main>
<section id="home" class="page active">
<div class="card">
<h2>🌎 Starting Location</h2>
<div class="muted">Choose where your empire begins. Location affects costs, demand and starting opportunities.</div>
<div id="locationGrid" class="grid" style="margin-top:10px"></div>
</div>
<div class="card">
<h2>📊 Business Dashboard</h2>
<div class="grid">
<div class="stat"><div class="label">REVENUE/DAY</div><div class="value" id="dashRevenue">$0</div></div>
<div class="stat"><div class="label">EXPENSES/DAY</div><div class="value" id="dashExpenses">$0</div></div>
<div class="stat"><div class="label">PROFIT/DAY</div><div class="value" id="dashProfit">$0</div></div>
<div class="stat"><div class="label">ASSETS</div><div class="value" id="dashAssets">$100</div></div>
<div class="stat"><div class="label">EMPLOYEES</div><div class="value" id="dashEmployees">0</div></div>
<div class="stat"><div class="label">NET WORTH</div><div class="value" id="dashNetWorth">$100</div></div>
</div>
</div>
<div class="card">
<h2>📊 Your Empire</h2>
<div class="money" id="homeCash">$100</div>
<div class="muted">Daily business income</div>
<div class="progress"><div class="bar" id="incomeBar"></div></div>
<div class="row"><span class="muted">Income/day</span><b id="income">$0</b></div>
<button class="action" onclick="nextDay()">🌅 Start Next Day</button>
</div>
<div class="card"><h2>📜 Activity</h2><div id="logs"></div></div>
</section>

<section id="business" class="page">
<div class="card"><h2>👥 Employees</h2><div class="muted">Employees increase revenue but add daily salary costs.</div><div id="employeeGrid" class="grid" style="margin-top:10px"></div></div>
<div class="card"><h2>🏪 Businesses</h2><div class="muted">Buy businesses and grow your income.</div></div>
<div class="grid" id="businessGrid"></div>
</section>

<section id="upgrade" class="page">
<div class="card">
<h2>📈 Management</h2>
<div class="muted">Each management level multiplies your business income.</div>
<button class="action" onclick="upgradeEmpire()">Upgrade · <span id="upgradeCost">$250</span></button>
</div>
<div class="card"><h2>🏆 Milestones</h2><div id="milestones"></div></div>
</section>

<section id="more" class="page">
<div class="card">
<h2>⚙️ Game</h2>
<button class="action" onclick="saveGame()">💾 Save Game</button>
<button class="action" onclick="resetGame()">🗑️ New Game</button>
</div>
<div class="card"><h2>ℹ️ Offline</h2><div class="muted">Progress is saved on this device. No internet is required.</div></div>
</section>
</main>

<nav>
<button class="active" onclick="showPage('home',this)">🏠<br>Home</button>
<button onclick="showPage('business',this)">🏪<br>Business</button>
<button onclick="showPage('upgrade',this)">📈<br>Upgrade</button>
<button onclick="showPage('more',this)">⚙️<br>More</button>
</nav>
</div>

<script>
const locations=[
{id:'jamaica',name:'🇯🇲 Jamaica',cost:1,demand:1,bonus:'Balanced market'},
{id:'miami',name:'🌴 Miami',cost:1.25,demand:1.25,bonus:'High customer demand'},
{id:'newyork',name:'🗽 New York',cost:1.7,demand:1.6,bonus:'Huge market, high costs'},
{id:'london',name:'🇬🇧 London',cost:1.9,demand:1.55,bonus:'Premium customers'}
];
const employees=[
{id:'worker',name:'General Worker',emoji:'🧑‍🔧',cost:100,salary:15,bonus:25},
{id:'sales',name:'Salesperson',emoji:'🧑‍💼',cost:400,salary:45,bonus:90},
{id:'manager',name:'Manager',emoji:'👔',cost:1200,salary:100,bonus:220}
];

const businesses=[
{id:'stand',name:'Lemonade Stand',emoji:'🍋',cost:100,income:15,desc:'Your first tiny hustle.'},
{id:'carwash',name:'Car Wash',emoji:'🚗',cost:500,income:65,desc:'Steady local customers.'},
{id:'shop',name:'Mini Mart',emoji:'🏪',cost:1800,income:220,desc:'Your first serious business.'},
{id:'restaurant',name:'Restaurant',emoji:'🍔',cost:6500,income:850,desc:'A busy food operation.'},
{id:'tech',name:'Tech Company',emoji:'💻',cost:25000,income:3600,desc:'Scale beyond your neighborhood.'},
{id:'hotel',name:'Hotel',emoji:'🏨',cost:100000,income:15000,desc:'Welcome to the big leagues.'}
];

let game=JSON.parse(localStorage.getItem('hustleEmpire'))||{
cash:100,rep:0,day:1,management:1,owned:{},employees:{},location:null,logs:[]
};

function money(n){return '$'+Math.floor(n).toLocaleString()}
function locationData(){return locations.find(x=>x.id===game.location)||locations[0]}
function employeeCount(){return Object.values(game.employees||{}).reduce((a,b)=>a+b,0)}
function employeeBonus(){
return employees.reduce((s,e)=>s+(game.employees?.[e.id]||0)*e.bonus,0)
}
function salary(){
return employees.reduce((s,e)=>s+(game.employees?.[e.id]||0)*e.salary,0)
}
function income(){
let loc=locationData();
return (businesses.reduce((s,b)=>s+(game.owned[b.id]||0)*b.income,0)*game.management*loc.demand)+employeeBonus()
}
function expenses(){return salary()}
function profit(){return Math.max(0,income()-expenses())}
function assets(){
return businesses.reduce((s,b)=>s+(game.owned[b.id]||0)*b.cost,0)
}
function saveGame(show=true){
localStorage.setItem('hustleEmpire',JSON.stringify(game));
if(show)addLog('💾 Game saved.');
}
function addLog(text){
game.logs.unshift(text);game.logs=game.logs.slice(0,8);
renderLogs();
}
function renderLogs(){
document.getElementById('logs').innerHTML=game.logs.length
?game.logs.map(x=>`<div class="log">${x}</div>`).join('')
:'<div class="muted">No activity yet.</div>';
}
function render(){
let inc=income();
cash.textContent=money(game.cash);homeCash.textContent=money(game.cash);
rep.textContent=game.rep;day.textContent=game.day;document.getElementById('income').textContent=money(profit());
document.getElementById('dashRevenue').textContent=money(income());
document.getElementById('dashExpenses').textContent=money(expenses());
document.getElementById('dashProfit').textContent=money(profit());
document.getElementById('dashAssets').textContent=money(game.cash+assets());
document.getElementById('dashEmployees').textContent=employeeCount();
document.getElementById('dashNetWorth').textContent=money(game.cash+assets());
document.getElementById('upgradeCost').textContent=money(250*Math.pow(3,game.management-1));
renderLocations();renderEmployees();
incomeBar.style.width=Math.min(100,inc/10000*100)+'%';
upgradeCost.textContent=money(250*Math.pow(3,game.management-1));
renderBusinesses();renderMilestones();renderLogs();
}
function renderBusinesses(){
businessGrid.innerHTML='';
businesses.forEach(b=>{
let owned=game.owned[b.id]||0;
let cost=Math.floor(b.cost*Math.pow(1.35,owned));
businessGrid.innerHTML+=`
<div class="biz">
<div class="emoji">${b.emoji}</div><h3>${b.name}</h3>
<p>${b.desc}</p><div class="muted">Owned: <b>${owned}</b></div>
<div class="muted">Income: ${money(b.income*game.management)}/day</div>
<button class="action" onclick="buy('${b.id}')" ${game.cash<cost?'disabled':''}>Buy ${money(cost)}</button>
</div>`;
});
}
function buy(id){
let b=businesses.find(x=>x.id===id),owned=game.owned[id]||0;
let cost=Math.floor(b.cost*Math.pow(1.35,owned));
if(game.cash<cost)return;
game.cash-=cost;game.owned[id]=owned+1;game.rep+=2;
addLog(`🏪 Bought ${b.name} for ${money(cost)}.`);
saveGame(false);render();
}
function nextDay(){
let inc=profit();game.cash+=inc;game.day++;
if(inc)game.rep++;
addLog(inc?`🌅 Day ${game.day}: earned ${money(inc)}.`:`🌅 Day ${game.day}: build your first business.`);
saveGame(false);render();
}
function upgradeEmpire(){
let cost=250*Math.pow(3,game.management-1);
if(game.cash<cost)return;
game.cash-=cost;game.management++;game.rep+=10;
addLog(`📈 Management upgraded to level ${game.management}.`);
saveGame(false);render();
}
function renderMilestones(){
let ms=[
['First Business',Object.values(game.owned).some(x=>x>0),'Own a business'],
['Entrepreneur',game.rep>=25,'Reach 25 reputation'],
['Small Empire',income()>=500,'Earn $500/day'],
['Big Player',income()>=5000,'Earn $5,000/day'],
['Mogul',game.cash>=1000000,'Hold $1,000,000 cash']
];
milestones.innerHTML=ms.map(m=>`<div class="row" style="padding:9px 0;border-bottom:1px solid #30394a">
<span>${m[1]?'🏆':'🔒'} ${m[0]}<br><small class="muted">${m[2]}</small></span>
<span class="badge">${m[1]?'UNLOCKED':'LOCKED'}</span></div>`).join('');
}
function renderLocations(){
const box=document.getElementById('locationGrid');
if(!box)return;
box.innerHTML=locations.map(l=>`<div class="biz">
<h3>${l.name}</h3><div class="muted">${l.bonus}</div>
<div class="muted">Cost index: ${l.cost}× · Demand: ${l.demand}×</div>
<button class="action" onclick="chooseLocation('${l.id}')" ${game.location?'disabled':''}>${game.location===l.id?'Selected':'Choose'}</button>
</div>`).join('');
}
function chooseLocation(id){
if(game.location)return;
game.location=id;
const l=locationData();
addLog(`🌎 Started your empire in ${l.name}.`);
saveGame(false);render();
}
function renderEmployees(){
const box=document.getElementById('employeeGrid');
if(!box)return;
box.innerHTML=employees.map(e=>{
let count=game.employees?.[e.id]||0;
return `<div class="biz"><div class="emoji">${e.emoji}</div><h3>${e.name}</h3>
<div class="muted">Owned: ${count}</div><div class="muted">+$${e.bonus}/day · Salary $${e.salary}/day</div>
<button class="action" onclick="hire('${e.id}')" ${game.cash<e.cost?'disabled':''}>Hire ${money(e.cost)}</button></div>`;
}).join('');
}
function hire(id){
const e=employees.find(x=>x.id===id);
if(game.cash<e.cost)return;
game.cash-=e.cost;
game.employees[id]=(game.employees[id]||0)+1;
game.rep+=1;
addLog(`👥 Hired a ${e.name} for ${money(e.cost)}.`);
saveGame(false);render();
}
function resetGame(){
if(confirm('Start a new game? Your current save will be replaced.')){
localStorage.removeItem('hustleEmpire');location.reload();
}}
function showPage(id,btn){
document.querySelectorAll('.page').forEach(x=>x.classList.remove('active'));
document.getElementById(id).classList.add('active');
document.querySelectorAll('nav button').forEach(x=>x.classList.remove('active'));
btn.classList.add('active');
}
render();
</script>
</body>
</html>
